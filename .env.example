APP_NAME=SmartKUET Sentinel
LOCATION=KUET Main Gate
CAMERA_SOURCE=0
DATABASE_PATH=smartkuet.db
MODEL_DIR=models
RUNS_DIR=runs
BENCHMARK_OUTPUT_DIR=runs/benchmarks
DATA_DIR=data
SNAPSHOT_DIR=snapshots
EVIDENCE_DIR=snapshots/evidence
SAMPLE_VIDEO_DIR=sample_videos
VIDEO_OUTPUT_DIR=runs/videos
TRACKING_OUTPUT_DIR=runs/tracking
CACHE_DIR=.cache
CAMERA_RECONNECT_SECONDS=2
CAMERA_LOOP_VIDEO=true
YOLO_ENABLED=true
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONF=0.35
YOLO_IMGSZ=640
YOLO_DEVICE=auto
DETECTION_EVERY_N_FRAMES=3
TRACKING_ENABLED=true
TRACKER_TYPE=bytetrack
TRACK_PERSON_CLASS_NAME=person
TRACK_CONF=0.35
TRACK_IOU=0.5
MAX_TRACK_AGE_SECONDS=5
SECURITY_RULES_ENABLED=true
SECURITY_NORMAL_START_HOUR=6
SECURITY_NORMAL_END_HOUR=22
CROWDING_PERSON_THRESHOLD=4
LOITER_SECONDS=15
SECURITY_EVENT_COOLDOWN_SECONDS=10
SECURITY_HIGH_RISK_COOLDOWN_SECONDS=5
SECURITY_LOCATION=KUET Main Gate
SECURITY_SAVE_EVENT_SNAPSHOT=true

# Demo Tuning Config (Milestone 1E)
DEMO_PROFILE=gate_daytime

# Gate-Zone ROI Filtering (Milestone 1J-lite)
# Normalized 0.0-1.0 frame fractions. Only counts tracks inside this zone.
GATE_ZONE_ENABLED=true
GATE_ZONE_X1=0.15
GATE_ZONE_Y1=0.20
GATE_ZONE_X2=0.85
GATE_ZONE_Y2=1.00

# Tracker Missed-Frames Pruning (Milestone 1J-lite)
# Prune ghost tracks after this many consecutive missed frames.
MAX_TRACK_MISSED_FRAMES=10

# Face Verification — Milestone 2B
# Enable face verification service (requires gallery prep first)
FACE_VERIFICATION_ENABLED=false
# Gallery of enrolled demo member images (gitignored)
FACE_GALLERY_DIR=data/demo_face_gallery
# Cached face embeddings .npy file (gitignored)
FACE_EMBEDDINGS_CACHE=data/face_embeddings/gallery_embeddings.npy
# InsightFace model pack name (buffalo_s = fast, small ~80MB)
FACE_MODEL_NAME=buffalo_s
# InsightFace model download cache dir (gitignored)
FACE_INSIGHTFACE_CACHE_DIR=.cache/insightface
# Cosine similarity threshold for VERIFIED_KNOWN_MEMBER
FACE_VERIFICATION_THRESHOLD=0.40
# Cosine similarity threshold for LOW_CONFIDENCE band
FACE_LOW_CONFIDENCE_THRESHOLD=0.30
